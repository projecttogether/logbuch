{
  "realm": "logbuch",
  "displayName": "Logbuch (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {
      "name": "logbuch",
      "path": "/logbuch"
    },
    {
      "name": "logbuch-admins",
      "path": "/logbuch-admins"
    },
    {
      "name": "teams",
      "path": "/teams",
      "subGroups": [
        {
          "name": "Engineering",
          "path": "/teams/Engineering"
        },
        {
          "name": "Operations",
          "path": "/teams/Operations"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "logbuch",
      "name": "Logbuch",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "logbuch-dev-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/oidc",
        "http://localhost:3001/api/auth/callback/oidc"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:3001/"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-logbuch",
      "enabled": true,
      "serviceAccountClientId": "logbuch",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
